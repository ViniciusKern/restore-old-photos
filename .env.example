NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
REPLICATE_API_TOKEN=
# Vercel Blob connection: managed OIDC authentication on Vercel.
BLOB_STORE_ID=
# Optional fallback for local development without Vercel OIDC.
BLOB_READ_WRITE_TOKEN=
# Redis names generated by the Vercel integration.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are also supported.
# For local OIDC, use Vercel CLI to pull credentials; do not invent a token.
# Production: HTTPS origin and Replicate's signing secret (not a Stripe secret).
APP_URL=
REPLICATE_WEBHOOK_SIGNING_SECRET=
# Transactional email: sender must belong to a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
